# Copy to .env and fill in. .env is gitignored - never commit real keys.
#
# Only EXPO_PUBLIC_* variables reach the client bundle. Anything secret belongs
# in Supabase Edge Function secrets (`supabase secrets set NAME=value`), never
# here, because everything in this file that starts with EXPO_PUBLIC_ is
# readable by anyone who opens the web app.

# --- Supabase (required) -----------------------------------------------------
# Project Settings -> API in the Supabase dashboard. The anon key is public by
# design; row level security is what protects the data, not the key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Public web URL (optional) -----------------------------------------------
# Used to build the customer-facing gate QR, e.g. https://noparchi.vercel.app
# Falls back to the current origin on web when unset.
EXPO_PUBLIC_WEB_URL=

# --- Payment (optional until Razorpay is enabled) ----------------------------
# Only the publishable key id belongs here. The key SECRET and webhook secret
# are Edge Function secrets, never client-side.
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# =============================================================================
# Server-side secrets - set these with the Supabase CLI, NOT in this file:
#
#   supabase secrets set RAZORPAY_KEY_SECRET=...
#   supabase secrets set RAZORPAY_WEBHOOK_SECRET=...
#   supabase secrets set WHATSAPP_ACCESS_TOKEN=...
#   supabase secrets set WHATSAPP_PHONE_NUMBER_ID=...
#
# SUPABASE_SERVICE_ROLE_KEY is injected into Edge Functions automatically.
# =============================================================================
