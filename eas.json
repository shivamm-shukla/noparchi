{
  "cli": { "version": ">= 5.9.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "NOPARCHI_ANDROID_ABIS": "arm64-v8a,x86_64"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NOPARCHI_ANDROID_ABIS": "arm64-v8a"
      },
      "ios": { "simulator": true }
    },
    "indus-store": {
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "NOPARCHI_ANDROID_ABIS": "armeabi-v7a,arm64-v8a,x86_64"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "NOPARCHI_ANDROID_ABIS": "armeabi-v7a,arm64-v8a,x86_64"
      }
    }
  },
  "submit": { "production": {} }
}
