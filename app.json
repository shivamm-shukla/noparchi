{
  "expo": {
    "name": "NoParchi",
    "slug": "noparchi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/noparchi-app-icon.png",
    "scheme": "noparchi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/noparchi-app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC",
      "dark": {
        "image": "./assets/noparchi-app-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "NoParchi uses your camera to scan and verify customer tickets at gate exit."
      }
    },
    "android": {
      "package": "com.noparchi.app",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/noparchi-app-icon.png",
        "backgroundColor": "#F8FAFC"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/noparchi-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "NoParchi uses camera to scan and verify exit tickets."
        }
      ],
      "expo-asset",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e8ce14b7-1279-4464-9e69-883f7d4d84e9"
      }
    }
  }
}
